# Virtual environments, local stores and generated delivery records.
.venv*/
.runtime*/
/evidence/
/.ai-lifecycle/
/.workbuddy/

# Publish only runtime inputs; development material stays local.
*.[mM][dD]
!/README.md
!/data/knowledge/01-rag.md
!/data/knowledge/02-memory.md
!/data/knowledge/03-runtime.md
!/data/knowledge/04-systems.md
/docs/
/tests/
test_*.py
*_test.py
*.test.*
*.spec.*
/.github/
/data/evaluation/
/requirements-dev.lock
/scripts/*
!/scripts/bootstrap_index.py
!/scripts/backup.py
!/scripts/demo.py
/examples/*
!/examples/__init__.py
!/examples/agentbase_server.py
!/examples/agentbase.json
!/examples/agentbase_enhancements.py
!/examples/agentbase_minimal.py

# Python, JavaScript and build outputs.
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/
node_modules/

# Environment files and credential material; keep the empty configuration template.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Runtime databases, logs and temporary/editor files.
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db-wal
*.db-shm
*.db-journal
owner.lock
*.log
*.tmp
*.bak
*.swp
*.swo
*~
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

