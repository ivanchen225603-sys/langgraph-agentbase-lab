# Local teaching mode needs no key. No external tracing is enabled.
LAB_MODE=local
LAB_HOST=127.0.0.1
LAB_PORT=8001
LAB_DATA_DIR=.runtime
LAB_KNOWLEDGE_ROOT=data/knowledge
# Explicit opt-in for OpenAI API. Do not use company documents without approval.
# LAB_MODE=openai
# OPENAI_API_KEY=
LAB_CHAT_MODEL=gpt-4.1-mini
LAB_EMBEDDING_MODEL=text-embedding-3-small
# Shared authentication is only a server-side static-token demonstration.
# LAB_AUTH_MODE=bearer
# LAB_BEARER_PRINCIPALS={"replace-with-long-secret":"alice"}
LAB_ENABLE_SIMULATION=false
