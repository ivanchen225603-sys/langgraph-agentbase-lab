    "name": "demo.number", "handler": "demo.number", "handler_version": "1", "description": "Double a number, or add explicitly supplied dependency results.",
    "scope": "read", "read_only": true,
    "input_schema": {"type": "object", "properties": {"x": {"type": "integer"}}, "required": ["x"], "additionalProperties": false},
    "output_schema": {"type": "object", "properties": {"value": {"type": "integer"}}, "required": ["value"], "additionalProperties": false}
  }],
  "agents": [
    {
      "id": "calculation", "description": "Configured fixed calculation without a model", "workflow": "fixed", "workflow_version": "1",
      "prompt": {"system_template": "Fixed tasks use schemas and handlers."},
      "input_schema": {"type": "object", "properties": {"left": {"type": "integer"}, "right": {"type": "integer"}}, "required": ["left", "right"], "additionalProperties": false},
      "tools": ["demo.number"],
      "tasks": [
        {"id": "left", "tool": "demo.number", "input_bindings": {"x": "/left"}},
        {"id": "right", "tool": "demo.number", "input_bindings": {"x": "/right"}},
        {"id": "total", "tool": "demo.number", "arguments": {"x": 0}, "depends_on": ["left", "right"], "use_dependencies": true}
